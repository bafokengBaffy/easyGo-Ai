# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easygo_ml_db
MONGODB_URL=mongodb://localhost:27017/easygo_ml

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai-ml-services

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=easygo_models

# Model Storage
MODEL_STORAGE_PATH=/models
MODEL_CACHE_SIZE=10

# Feature Store
FEATURE_STORE_URL=localhost:6566

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# Model Retraining
RETRAINING_SCHEDULE="0 0 * * 0"
MIN_DATA_POINTS_FOR_RETRAIN=1000

# Security
API_KEY=
JWT_SECRET=
